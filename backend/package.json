{
  "name": "shift-scheduler-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "description": "AIシフト管理システム バックエンドAPI",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:up": "node-pg-migrate up -m ../scripts/database/migrations -f .node-pg-migraterc.json",
    "db:migrate:down": "node-pg-migrate down -m ../scripts/database/migrations -f .node-pg-migraterc.json",
    "db:migrate:create": "node-pg-migrate create -m ../scripts/database/migrations -f .node-pg-migraterc.json",
    "db:migrate:status": "node-pg-migrate up --dry-run -m ../scripts/database/migrations -f .node-pg-migraterc.json",
    "db:migrate:fake": "node-pg-migrate up --fake -m ../scripts/database/migrations -f .node-pg-migraterc.json"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "openai": "^6.49.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "node-pg-migrate": "^7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
